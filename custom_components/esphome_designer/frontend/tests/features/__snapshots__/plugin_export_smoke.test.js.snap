exports[`Plugin Export Smoke Tests > Export for template_sensor_bar > should export standard C++ with stable output 1`] = `
[
  "        {",
  "          auto draw_filled_rrect = [&](int x, int y, int w, int h, int r, auto c) {",
  "            it.filled_rectangle(x + r, y, w - 2 * r, h, c);",
  "            it.filled_rectangle(x, y + r, r, h - 2 * r, c);",
  "            it.filled_rectangle(x + w - r, y + r, r, h - 2 * r, c);",
  "            it.filled_circle(x + r, y + r, r, c);",
  "            it.filled_circle(x + w - r - 1, y + r, r, c);",
  "            it.filled_circle(x + r, y + h - r - 1, r, c);",
  "            it.filled_circle(x + w - r - 1, y + h - r - 1, r, c);",
  "          };",
  "          draw_filled_rrect(10, 10, 100, 100, 8, color_on);",
  "          {",
  "            const char* wifi_icon = "\\U000F092B";",
  "            it.printf(23 - 4, 60, id(font_id), color_off, TextAlign::CENTER_RIGHT, "%s", wifi_icon);",
  "            it.printf(23 + 4, 60, id(font_id), color_off, TextAlign::CENTER_LEFT, "--dB");",
  "          }",
  "          {",
  "            it.printf(48 - 4, 60, id(font_id), color_off, TextAlign::CENTER_RIGHT, "%s", "\\U000F050F");",
  "            it.printf(48 + 4, 60, id(font_id), color_off, TextAlign::CENTER_LEFT, "--°C");",
  "          }",
  "          {",
  "            it.printf(73 - 4, 60, id(font_id), color_off, TextAlign::CENTER_RIGHT, "%s", "\\U000F058E");",
  "            it.printf(73 + 4, 60, id(font_id), color_off, TextAlign::CENTER_LEFT, "--%%");",
  "          }",
  "          {",
  "            const char* bat_icon = "\\U000F0082";",
  "            it.printf(98 - 4, 60, id(font_id), color_off, TextAlign::CENTER_RIGHT, "%s", bat_icon);",
  "            it.printf(98 + 4, 60, id(font_id), color_off, TextAlign::CENTER_LEFT, "--%%");",
  "          }",
  "        }",
]
`;

