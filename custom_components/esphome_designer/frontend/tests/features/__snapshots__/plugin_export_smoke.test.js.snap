exports[`Plugin Export Smoke Tests > Export for energy_widget > should export standard C++ with stable output 1`] = `
[
  "        {",
  "        it.rectangle(10 + 0, 10 + 0, 100 - 0, 100 - 0, Color(theme_auto));",
  "          char solar_buf[32] = "--";",
  "          float solar_value = 0.0f;",
  "          bool solar_valid = false;",
  "          char solar_to_home_buf[32] = "";",
  "          float solar_to_home_value = 0.0f;",
  "          bool solar_to_home_valid = false;",
  "          char solar_to_grid_buf[32] = "";",
  "          float solar_to_grid_value = 0.0f;",
  "          bool solar_to_grid_valid = false;",
  "          char solar_to_battery_buf[32] = "";",
  "          float solar_to_battery_value = 0.0f;",
  "          bool solar_to_battery_valid = false;",
  "          char autoconsumption_pct_buf[32] = "";",
  "          float autoconsumption_pct_value = 0.0f;",
  "          bool autoconsumption_pct_valid = false;",
  "          char home_buf[32] = "--";",
  "          float home_value = 0.0f;",
  "          bool home_valid = false;",
  "          char grid_buf[32] = "--";",
  "          float grid_value = 0.0f;",
  "          bool grid_valid = false;",
  "          char battery_power_buf[32] = "--";",
  "          float battery_power_value = 0.0f;",
  "          bool battery_power_valid = false;",
  "          char battery_soc_buf[32] = "--";",
  "          float battery_soc_value = 0.0f;",
  "          bool battery_soc_valid = false;",
  "          char gas_buf[32] = "--";",
  "          float gas_value = 0.0f;",
  "          bool gas_valid = false;",
  "          bool solar_active = solar_valid && (solar_value > 0.05f || solar_value < -0.05f);",
  "          bool gas_active = gas_valid && (gas_value > 0.05f || gas_value < -0.05f);",
  "          const char* solar_arrow = solar_active ? "v" : " ";",
  "          const char* gas_arrow = gas_active ? "^" : " ";",
  "          auto flow_color = Color(#3b7c3f);",
  "          auto inactive_flow_color = Color(#8a8a8a);",
  "          const char* grid_arrow = " ";",
  "          const char* grid_label = "";",
  "          bool grid_active = false;",
  "          if (grid_valid && (grid_value > 0.05f || grid_value < -0.05f)) {",
  "            grid_active = true;",
  "            if (grid_value > 0.0f) { grid_arrow = ">"; grid_label = "Import"; }",
  "            else { grid_arrow = "<"; grid_label = "Export"; }",
  "          }",
  "          const char* battery_arrow = " ";",
  "          const char* battery_label = "";",
  "          bool battery_active = false;",
  "          if (battery_power_valid && (battery_power_value > 0.05f || battery_power_value < -0.05f)) {",
  "            battery_active = true;",
  "            if (battery_power_value > 0.0f) { battery_arrow = ">"; battery_label = "Charging"; }",
  "            else { battery_arrow = "<"; battery_label = "Discharging"; }",
  "          }",
  "          if (solar_to_grid_valid && solar_to_grid_value < 0.0f) solar_to_grid_value = 0.0f;",
  "          if (solar_to_home_valid && solar_to_home_value < 0.0f) solar_to_home_value = 0.0f;",
  "          if (solar_to_battery_valid && solar_to_battery_value < 0.0f) solar_to_battery_value = 0.0f;",
  "          if (autoconsumption_pct_valid) {",
  "            if (autoconsumption_pct_value < 0.0f) autoconsumption_pct_value = 0.0f;",
  "            if (autoconsumption_pct_value > 100.0f) autoconsumption_pct_value = 100.0f;",
  "            sprintf(autoconsumption_pct_buf, "%.0f%%", autoconsumption_pct_value);",
  "          }",
  "          if (!solar_to_grid_valid && grid_active && strcmp(grid_label, "Export") == 0) {",
  "            solar_to_grid_value = fabsf(grid_value);",
  "            solar_to_grid_valid = true;",
  "            sprintf(solar_to_grid_buf, "%.0f W", solar_to_grid_value);",
  "          }",
  "          if (!autoconsumption_pct_valid && solar_valid && solar_value > 0.05f) {",
  "            float solar_self_consumed = solar_value - (solar_to_grid_valid ? solar_to_grid_value : 0.0f);",
  "            if (solar_self_consumed < 0.0f) solar_self_consumed = 0.0f;",
  "            if (solar_self_consumed > solar_value) solar_self_consumed = solar_value;",
  "            autoconsumption_pct_value = (solar_self_consumed / solar_value) * 100.0f;",
  "            if (autoconsumption_pct_value < 0.0f) autoconsumption_pct_value = 0.0f;",
  "            if (autoconsumption_pct_value > 100.0f) autoconsumption_pct_value = 100.0f;",
  "            autoconsumption_pct_valid = true;",
  "            sprintf(autoconsumption_pct_buf, "%.0f%%", autoconsumption_pct_value);",
  "          }",
  "          if (!solar_to_home_valid && solar_valid && solar_value > 0.05f && solar_to_battery_valid) {",
  "            float solar_self_consumed = solar_value - (solar_to_grid_valid ? solar_to_grid_value : 0.0f);",
  "            if (solar_self_consumed < 0.0f) solar_self_consumed = 0.0f;",
  "            if (solar_self_consumed > solar_value) solar_self_consumed = solar_value;",
  "            solar_to_home_value = solar_self_consumed - solar_to_battery_value;",
  "            if (solar_to_home_value < 0.0f) solar_to_home_value = 0.0f;",
  "            solar_to_home_valid = true;",
  "            sprintf(solar_to_home_buf, "%.0f W", solar_to_home_value);",
  "          }",
  "          char solar_subvalue_buf[32] = "";",
  "          if (autoconsumption_pct_valid) {",
  "            snprintf(solar_subvalue_buf, sizeof(solar_subvalue_buf), "Self %.0f%%", autoconsumption_pct_value);",
  "          }",
  "          char solar_flow_label_buf[32] = "";",
  "          if (solar_to_home_valid && solar_to_home_value > 0.05f) {",
  "            snprintf(solar_flow_label_buf, sizeof(solar_flow_label_buf), "Home %.0f W", solar_to_home_value);",
  "          }",
  "          char grid_flow_label_buf[32] = "";",
  "          if (grid_active) {",
  "            float grid_flow_value = strcmp(grid_label, "Export") == 0 && solar_to_grid_valid ? solar_to_grid_value : fabsf(grid_value);",
  "            if (grid_flow_value < 0.0f) grid_flow_value = 0.0f;",
  "            if (strcmp(grid_label, "Export") == 0) {",
  "              snprintf(grid_flow_label_buf, sizeof(grid_flow_label_buf), "Export %.0f W", grid_flow_value);",
  "            } else {",
  "              snprintf(grid_flow_label_buf, sizeof(grid_flow_label_buf), "Import %.0f W", grid_flow_value);",
  "            }",
  "          }",
  "          char battery_flow_label_buf[32] = "";",
  "          if (battery_active) {",
  "            if (strcmp(battery_label, "Charging") == 0 && solar_to_battery_valid && solar_to_battery_value > 0.05f) {",
  "              snprintf(battery_flow_label_buf, sizeof(battery_flow_label_buf), "Solar %.0f W", solar_to_battery_value);",
  "            } else {",
  "              float battery_flow_value = fabsf(battery_power_value);",
  "              if (strcmp(battery_label, "Charging") == 0) {",
  "                snprintf(battery_flow_label_buf, sizeof(battery_flow_label_buf), "Charging %.0f W", battery_flow_value);",
  "              } else {",
  "                snprintf(battery_flow_label_buf, sizeof(battery_flow_label_buf), "Discharging %.0f W", battery_flow_value);",
  "              }",
  "            }",
  "          }",
  "        it.line(100, 52, 100, 53, solar_active ? flow_color : inactive_flow_color);",
  "        it.printf(100, 53, id(font_id), solar_active ? flow_color : inactive_flow_color, TextAlign::CENTER, "%s", solar_arrow);",
  "        it.printf(100, 43, id(font_id), solar_active ? flow_color : inactive_flow_color, TextAlign::CENTER, "%s", solar_flow_label_buf);",
  "        it.line(79, 70, 69, 70, grid_active ? flow_color : inactive_flow_color);",
  "        it.printf(74, 70, id(font_id), grid_active ? flow_color : inactive_flow_color, TextAlign::CENTER, "%s", grid_arrow);",
  "        it.printf(74, 60, id(font_id), grid_active ? flow_color : inactive_flow_color, TextAlign::CENTER, "%s", grid_flow_label_buf);",
  "        it.line(131, 70, 121, 70, battery_active ? flow_color : inactive_flow_color);",
  "        it.printf(126, 70, id(font_id), battery_active ? flow_color : inactive_flow_color, TextAlign::CENTER, "%s", battery_arrow);",
  "        it.printf(126, 60, id(font_id), battery_active ? flow_color : inactive_flow_color, TextAlign::CENTER, "%s", battery_flow_label_buf);",
  "        it.rectangle(69 + 0, 18 + 0, 62 - 0, 34 - 0, Color(theme_auto));",
  "        it.printf(100, 22, id(font_id), Color(theme_auto), TextAlign::TOP_CENTER, "Solar");",
  "        it.printf(100, 34, id(font_id), Color(theme_auto), TextAlign::CENTER, "%s", solar_buf);",
  "        it.printf(100, 47, id(font_id), Color(theme_auto), TextAlign::BOTTOM_CENTER, "%s", solar_subvalue_buf);",
  "        it.rectangle(69 + 0, 53 + 0, 62 - 0, 34 - 0, Color(theme_auto));",
  "        it.printf(100, 57, id(font_id), Color(theme_auto), TextAlign::TOP_CENTER, "Home");",
  "        it.printf(100, 70, id(font_id), Color(theme_auto), TextAlign::CENTER, "%s", home_buf);",
  "        it.rectangle(21 + 0, 53 + 0, 58 - 0, 34 - 0, Color(theme_auto));",
  "        it.printf(50, 57, id(font_id), Color(theme_auto), TextAlign::TOP_CENTER, "Grid");",
  "        it.printf(50, 69, id(font_id), Color(theme_auto), TextAlign::CENTER, "%s", grid_buf);",
  "        it.printf(50, 82, id(font_id), Color(theme_auto), TextAlign::BOTTOM_CENTER, "%s", grid_label);",
  "        it.rectangle(121 + 0, 53 + 0, 58 - 0, 34 - 0, Color(theme_auto));",
  "        it.printf(150, 57, id(font_id), Color(theme_auto), TextAlign::TOP_CENTER, "Battery");",
  "        it.printf(150, 69, id(font_id), Color(theme_auto), TextAlign::CENTER, "%s", battery_power_buf);",
  "        it.printf(150, 82, id(font_id), Color(theme_auto), TextAlign::BOTTOM_CENTER, "%s", battery_soc_buf);",
  "        }",
]
`;

