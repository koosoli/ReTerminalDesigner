exports[`Plugin Export Smoke Tests > Export for moon_phase > should export standard C++ with stable output 1`] = `
[
  "        {",
  "          std::string raw_state = id(sensor_moon_txt).state;",
  "          std::string moon_state = "";",
  "          for (auto c : raw_state) {",
  "            if (c == '-' || c == ' ') moon_state += '_';",
  "            else moon_state += static_cast<char>(tolower(static_cast<unsigned char>(c)));",
  "          }",
  "          const char* icon = "\\U000F0625";",
  "          if (moon_state == "waxing_crescent") icon = "\\U000F0F67";",
  "          else if (moon_state == "first_quarter") icon = "\\U000F0F61";",
  "          else if (moon_state == "waxing_gibbous") icon = "\\U000F0F68";",
  "          else if (moon_state == "full_moon") icon = "\\U000F0F62";",
  "          else if (moon_state == "waning_gibbous") icon = "\\U000F0F66";",
  "          else if (moon_state == "last_quarter") icon = "\\U000F0F63";",
  "          else if (moon_state == "waning_crescent") icon = "\\U000F0F65";",
  "          else if (moon_state == "new_moon") icon = "\\U000F0F64";",
  "          else if (moon_state != "" && moon_state != "unknown" && moon_state != "unavailable") ESP_LOGW("moon_phase", "Unhandled moon phase: %s", raw_state.c_str());",
  "          it.printf(60, 60, id(font_id), color_on, TextAlign::CENTER, "%s", icon);",
  "        }",
]
`;

