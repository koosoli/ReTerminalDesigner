  "        condition:",
  "          lambda: 'return id(display_page) == 0 && (millis() - id(last_touch_time) > 250);'",
  "        then:",
  "          - lambda: 'id(last_touch_time) = millis();'",
  "          - script.execute: manage_run_and_sleep",
]
`;

