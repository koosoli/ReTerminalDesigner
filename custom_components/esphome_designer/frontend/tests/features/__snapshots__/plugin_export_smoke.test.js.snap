          "id": "w_test_sunrise_icon",
          "text": ""\\U000F059C"",
          "text_align": "left",
          "text_color": "Color(theme_auto)",
          "text_font": "font_ptr",
          "width": 22,
          "x": 6,
          "y": 29,
        },
      },
      {
        "label": {
          "height": 20,
          "id": "w_test_sunrise_text",
          "text": "!lambda |-
          static std::string display_value;
          display_value = "n.d.";
          std::string raw = id(sensor_sun_next_rising_txt).state;
          if (!raw.empty() && raw != "unknown" && raw != "unavailable" && raw != "none") {
            int year = 0;
            int month = 0;
            int day = 0;
            int hour = 0;
            int minute = 0;
            int second = 0;
            int offset_hour = 0;
            int offset_minute = 0;
            char tz_sign = '+';
            auto format_hhmm = [](int hour_value, int minute_value) -> std::string {
              char buf[6];
              snprintf(buf, sizeof(buf), "%02d:%02d", hour_value, minute_value);
              return std::string(buf);
            };
            auto days_from_civil = [](int y, unsigned m, unsigned d) -> int {
              y -= m <= 2;
              const int era = (y >= 0 ? y : y - 399) / 400;
              const unsigned yoe = static_cast<unsigned>(y - era * 400);
              const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
              const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
              return era * 146097 + static_cast<int>(doe) - 719468;
            };
            auto parse_epoch = [&](char sign, int tzHour, int tzMinute) -> long long {
              const int offset_minutes = (tzHour * 60 + tzMinute) * (sign == '-' ? -1 : 1);
              return static_cast<long long>(days_from_civil(year, static_cast<unsigned>(month), static_cast<unsigned>(day))) * 86400LL +
                  static_cast<long long>(hour) * 3600LL + static_cast<long long>(minute) * 60LL + second -
                  static_cast<long long>(offset_minutes) * 60LL;
            };
            auto try_local_datetime = [&](char sign, int tzHour, int tzMinute) -> bool {
              time_t ts = static_cast<time_t>(parse_epoch(sign, tzHour, tzMinute));
              struct tm* local_tm = localtime(&ts);
              if (local_tm == nullptr) return false;
              display_value = format_hhmm(local_tm->tm_hour, local_tm->tm_min);
              return true;
            };
            if (sscanf(raw.c_str(), "%d-%d-%dT%d:%d:%d%c%d:%d", &year, &month, &day, &hour, &minute, &second, &tz_sign, &offset_hour, &offset_minute) == 9 && try_local_datetime(tz_sign, offset_hour, offset_minute)) {
            } else if (sscanf(raw.c_str(), "%d-%d-%dT%d:%d:%dZ", &year, &month, &day, &hour, &minute, &second) == 6 && try_local_datetime('+', 0, 0)) {
            } else if (sscanf(raw.c_str(), "%d-%d-%dT%d:%d", &year, &month, &day, &hour, &minute) == 5) {
              display_value = format_hhmm(hour, minute);
            } else {
              size_t t_pos = raw.find('T');
              size_t colon = raw.find(':');
              if (t_pos != std::string::npos && colon != std::string::npos && colon >= 2) display_value = raw.substr(colon - 2, 5);
              else if (colon != std::string::npos && colon >= 1) {
                size_t start = colon >= 2 ? colon - 2 : 0;
                size_t len = (start + 5 <= raw.size()) ? 5 : raw.size() - start;
                display_value = raw.substr(start, len);
              } else {
                display_value = raw;
              }
            }
          }
          return display_value.c_str();",
          "text_align": "left",
          "text_color": "Color(theme_auto)",
          "text_font": "font_ptr",
          "width": 62,
          "x": 32,
          "y": 30,
        },
      },
      {
        "label": {
          "height": 20,
          "id": "w_test_sunset_icon",
          "text": ""\\U000F059B"",
          "text_align": "left",
          "text_color": "Color(theme_auto)",
          "text_font": "font_ptr",
          "width": 22,
          "x": 6,
          "y": 53,
        },
      },
      {
        "label": {
          "height": 20,
          "id": "w_test_sunset_text",
          "text": "!lambda |-
          static std::string display_value;
          display_value = "n.d.";
