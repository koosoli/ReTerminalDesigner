              char buf[6];
              snprintf(buf, sizeof(buf), "%02d:%02d", hour_value, minute_value);
              return std::string(buf);
            };
            auto days_from_civil = [](int y, unsigned m, unsigned d) -> int {
              y -= m <= 2;
              const int era = (y >= 0 ? y : y - 399) / 400;
              const unsigned yoe = static_cast<unsigned>(y - era * 400);
              const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
              const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
              return era * 146097 + static_cast<int>(doe) - 719468;
            };
            auto parse_epoch = [&](char sign, int tzHour, int tzMinute) -> long long {
              const int offset_minutes = (tzHour * 60 + tzMinute) * (sign == '-' ? -1 : 1);
              return static_cast<long long>(days_from_civil(year, static_cast<unsigned>(month), static_cast<unsigned>(day))) * 86400LL +
                  static_cast<long long>(hour) * 3600LL + static_cast<long long>(minute) * 60LL + second -
                  static_cast<long long>(offset_minutes) * 60LL;
            };
            auto try_local_datetime = [&](char sign, int tzHour, int tzMinute) -> bool {
              time_t ts = static_cast<time_t>(parse_epoch(sign, tzHour, tzMinute));
              struct tm* local_tm = localtime(&ts);
              if (local_tm == nullptr) return false;
              display_value = format_hhmm(local_tm->tm_hour, local_tm->tm_min);
              return true;
            };
            if (sscanf(raw.c_str(), "%d-%d-%dT%d:%d:%d%c%d:%d", &year, &month, &day, &hour, &minute, &second, &tz_sign, &offset_hour, &offset_minute) == 9 && try_local_datetime(tz_sign, offset_hour, offset_minute)) {
