exports[`Plugin Export Smoke Tests > Export for moon_phase > should export LVGL with stable output 1`] = `
{
  "label": {
    "text": "!lambda |-
          std::string moon_state = id(sensor_moon_txt).state;
          std::string normalized = "";
          for (auto c : moon_state) {
            if (c == '-' || c == ' ') normalized += '_';
            else normalized += static_cast<char>(tolower(static_cast<unsigned char>(c)));
          }
          if (normalized == "waxing_crescent") return "\\U000F0F67";
          if (normalized == "first_quarter") return "\\U000F0F61";
          if (normalized == "waxing_gibbous") return "\\U000F0F68";
          if (normalized == "full_moon") return "\\U000F0F62";
          if (normalized == "waning_gibbous") return "\\U000F0F66";
          if (normalized == "last_quarter") return "\\U000F0F63";
          if (normalized == "waning_crescent") return "\\U000F0F65";
          if (normalized == "new_moon") return "\\U000F0F64";
          return "\\U000F0625";",
    "text_align": "center",
    "text_color": "Color(theme_auto)",
    "text_font": "font_ptr",
  },
}
`;

