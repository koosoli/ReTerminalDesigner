            if (sig >= -50) return "\\U000F0928";
            if (sig >= -60) return "\\U000F0925";
            if (sig >= -75) return "\\U000F0922";
            if (sig >= -100) return "\\U000F091F";
            return "\\U000F092B";
          }
          return "\\U000F092B";",
          "text_color": "Color(theme_auto)",
          "text_font": "font_ptr",
          "width": 34,
        },
      },
      {
        "label": {
          "align": "bottom_mid",
          "height": 16,
          "id": "w_test_text",
          "text": "!lambda |-
          if (id(wifi_signal_dbm).has_state()) {
            return str_sprintf("%.0fdB", id(wifi_signal_dbm).state).c_str();
          }
          return "---dB";",
          "text_align": "center",
          "text_color": "Color(theme_auto)",
          "text_font": "font_ptr",
          "width": "100%",
          "y": 2,
        },
      },
    ],
  },
}
`;

